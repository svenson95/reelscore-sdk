{
  "name": "reelscore-sdk",
  "version": "0.2.0",
  "private": true,
  "description": "OpenAPI contracts, generated TypeScript models, shared helpers and constants.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./models": {
      "import": {
        "types": "./dist/esm/models/index.d.ts",
        "default": "./dist/esm/models/index.js"
      },
      "require": {
        "types": "./dist/cjs/models/index.d.ts",
        "default": "./dist/cjs/models/index.js"
      }
    },
    "./constants": {
      "import": {
        "types": "./dist/esm/shared/constants/index.d.ts",
        "default": "./dist/esm/shared/constants/index.js"
      },
      "require": {
        "types": "./dist/cjs/shared/constants/index.d.ts",
        "default": "./dist/cjs/shared/constants/index.js"
      }
    },
    "./helpers": {
      "import": {
        "types": "./dist/esm/shared/helpers/index.d.ts",
        "default": "./dist/esm/shared/helpers/index.js"
      },
      "require": {
        "types": "./dist/cjs/shared/helpers/index.d.ts",
        "default": "./dist/cjs/shared/helpers/index.js"
      }
    },
    "./openapi/fixtures": "./openapi/fixtures.openapi.json",
    "./openapi/week-data": "./openapi/week-data.openapi.json",
    "./openapi/statistics": "./openapi/statistics.openapi.json",
    "./openapi/analyses": "./openapi/analyses.openapi.json",
    "./openapi/live-updates": "./openapi/live-updates.openapi.json",
    "./openapi/fixture-status": "./openapi/fixture-status.openapi.json",
    "./openapi/coaches": "./openapi/coaches.openapi.json",
    "./openapi/competitions": "./openapi/competitions.openapi.json",
    "./openapi/teams": "./openapi/teams.openapi.json",
    "./openapi/players": "./openapi/players.openapi.json",
    "./openapi/standings": "./openapi/standings.openapi.json",
    "./openapi/reelscore": "./openapi/reelscore.openapi.json",
    "./openapi/evaluations": "./openapi/evaluations.openapi.json",
    "./openapi/common": "./openapi/common.openapi.json",
    "./openapi/events": "./openapi/events.openapi.json",
    "./openapi/provider-responses": "./openapi/provider-responses.openapi.json",
    "./openapi/search": "./openapi/search.openapi.json",
    "./openapi": "./openapi/reelscore.bundled.openapi.json"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "scripts": {
    "generate": "node scripts/generate-models.mjs",
    "check:generated": "node scripts/generate-models.mjs --check",
    "build": "npm run generate && node scripts/build.mjs",
    "test": "npm run build && npm run test:types && node --test tests/*.test.mjs",
    "lint": "eslint --ext .ts,.mjs src scripts tests",
    "prepack": "npm run check:generated && npm run lint && npm test",
    "test:types": "tsc -p tests/tsconfig.json --noEmit"
  },
  "dependencies": {
    "moment": "2.30.1",
    "moment-timezone": "0.5.48"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "openapi-typescript": "7.10.1",
    "ajv": "8.17.1",
    "eslint": "8.57.0",
    "@typescript-eslint/parser": "7.18.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "prettier": "2.6.2"
  },
  "typesVersions": {
    "*": {
      "models": [
        "dist/cjs/models/index.d.ts"
      ],
      "constants": [
        "dist/cjs/shared/constants/index.d.ts"
      ],
      "helpers": [
        "dist/cjs/shared/helpers/index.d.ts"
      ]
    }
  }
}
