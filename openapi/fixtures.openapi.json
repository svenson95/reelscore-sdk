{
  "openapi": "3.1.0",
  "info": {
    "title": "reelscore fixture contracts",
    "version": "0.1.0",
    "description": "Shared data contracts. This first migration describes models only; it does not introduce HTTP endpoints."
  },
  "paths": {},
  "components": {
    "schemas": {
      "MongoDbId": {
        "type": "string"
      },
      "TeamId": {
        "type": "number"
      },
      "TeamName": {
        "type": "string"
      },
      "TeamLogo": {
        "type": "string"
      },
      "PlayerId": {
        "type": "number"
      },
      "PlayerName": {
        "type": "string"
      },
      "CompetitionId": {
        "type": "number"
      },
      "CompetitionName": {
        "type": "string"
      },
      "CompetitionSeason": {
        "type": "number"
      },
      "CompetitionRound": {
        "type": "string"
      },
      "Team": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/TeamId"
          },
          "name": {
            "$ref": "#/components/schemas/TeamName"
          },
          "logo": {
            "$ref": "#/components/schemas/TeamLogo"
          }
        },
        "required": ["id", "name", "logo"]
      },
      "FixtureLeague": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/CompetitionId"
          },
          "name": {
            "$ref": "#/components/schemas/CompetitionName"
          },
          "country": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "flag": {
            "type": ["string", "null"]
          },
          "season": {
            "$ref": "#/components/schemas/CompetitionSeason"
          },
          "standings": {
            "type": "boolean"
          },
          "round": {
            "$ref": "#/components/schemas/CompetitionRound"
          }
        },
        "required": ["id", "name", "country", "logo", "flag", "season", "round"]
      },
      "StatusLong": {
        "type": "string",
        "enum": [
          "Time To Be Defined",
          "Not Started",
          "First Half, Kick Off",
          "Halftime",
          "Second Half, 2nd Half Started",
          "Extra Time",
          "Break Time",
          "Penalty in Progress",
          "Match Suspended",
          "Match Interrupted",
          "Match Finished",
          "Match Postponed",
          "Match Cancelled",
          "Match Abandoned",
          "Technical Loss",
          "WalkOver",
          "In Progress"
        ]
      },
      "StatusShort": {
        "type": "string",
        "description": "Kept open for compatibility: the existing status arrays are typed as string[], so StatusShort currently accepts any string. Narrowing to an enum is a separate contract change."
      },
      "EventTime": {
        "type": "object",
        "properties": {
          "elapsed": {
            "type": "number"
          },
          "extra": {
            "type": ["number", "null"]
          }
        },
        "required": ["elapsed", "extra"]
      },
      "EventTeam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          },
          "goals": {
            "type": "number"
          }
        },
        "required": ["id", "name", "logo", "goals"]
      },
      "EventPlayer": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/PlayerId"
          },
          "name": {
            "$ref": "#/components/schemas/PlayerName"
          }
        },
        "required": ["id", "name"]
      },
      "EventAssist": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlayerId"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PlayerName"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "name"]
      },
      "EventType": {
        "type": "string",
        "enum": ["Goal", "Card", "subst", "Var"]
      },
      "EventDetail": {
        "type": "string",
        "enum": [
          "Normal Goal",
          "Own Goal",
          "Penalty",
          "Missed Penalty",
          "Yellow Card",
          "Red Card",
          "Tripping",
          "Roughing",
          "Argument",
          "Holding",
          "Delay of game",
          "Elbowing",
          "Unsportsmanlike conduct",
          "Serious foul",
          "Goal cancelled",
          "Goal Disallowed - handball",
          "Goal Disallowed - offside",
          "Diving",
          "Penalty confirmed",
          "Substitution",
          "Substitution 1",
          "Substitution 2",
          "Substitution 3",
          "Substitution 4",
          "Substitution 5",
          "Substitution 6",
          "Substitution 7",
          "Substitution 8",
          "Substitution 9",
          "Substitution 10"
        ]
      },
      "EventDTO": {
        "type": "object",
        "properties": {
          "time": {
            "$ref": "#/components/schemas/EventTime"
          },
          "team": {
            "$ref": "#/components/schemas/EventTeam"
          },
          "player": {
            "$ref": "#/components/schemas/EventPlayer"
          },
          "assist": {
            "$ref": "#/components/schemas/EventAssist"
          },
          "type": {
            "$ref": "#/components/schemas/EventType"
          },
          "detail": {
            "$ref": "#/components/schemas/EventDetail"
          },
          "comments": {
            "type": "string"
          }
        },
        "required": [
          "time",
          "team",
          "player",
          "assist",
          "type",
          "detail",
          "comments"
        ]
      },
      "FixtureDetail": {
        "type": "string",
        "enum": [
          "lineups",
          "fixture-statistics",
          "players-statistics",
          "events"
        ]
      },
      "FixtureId": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "FixtureIdParameter": {
        "type": "string"
      },
      "FixtureDateString": {
        "type": "string",
        "description": "Existing fixture date string; no new format constraint is introduced by this migration."
      },
      "FixturePeriods": {
        "type": "object",
        "properties": {
          "first": {
            "type": "number"
          },
          "second": {
            "type": "number"
          }
        },
        "required": ["first", "second"]
      },
      "VenueId": {
        "type": "number"
      },
      "FixtureVenue": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VenueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "required": ["id", "name", "city"]
      },
      "FixtureStatus": {
        "type": "object",
        "properties": {
          "long": {
            "$ref": "#/components/schemas/StatusLong"
          },
          "short": {
            "$ref": "#/components/schemas/StatusShort"
          },
          "elapsed": {
            "type": ["number", "null"]
          },
          "extra": {
            "type": ["number", "null"]
          }
        },
        "required": ["long", "short", "elapsed", "extra"]
      },
      "FixtureResult": {
        "type": "string",
        "enum": ["NO_RESULT_AVAILABLE", "WIN", "DRAW", "LOSS"]
      },
      "Fixture": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/FixtureId"
          },
          "referee": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "date": {
            "$ref": "#/components/schemas/FixtureDateString"
          },
          "timestamp": {
            "type": "number",
            "description": "Unix timestamp in seconds."
          },
          "periods": {
            "$ref": "#/components/schemas/FixturePeriods"
          },
          "venue": {
            "$ref": "#/components/schemas/FixtureVenue"
          },
          "status": {
            "$ref": "#/components/schemas/FixtureStatus"
          }
        },
        "required": [
          "id",
          "referee",
          "timezone",
          "date",
          "timestamp",
          "periods",
          "venue",
          "status"
        ]
      },
      "FixtureTeam": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Team"
          },
          {
            "type": "object",
            "properties": {
              "winner": {
                "type": "boolean"
              }
            },
            "required": ["winner"]
          }
        ]
      },
      "MatchTeams": {
        "type": "object",
        "properties": {
          "home": {
            "$ref": "#/components/schemas/FixtureTeam"
          },
          "away": {
            "$ref": "#/components/schemas/FixtureTeam"
          }
        },
        "required": ["home", "away"]
      },
      "Goals": {
        "type": "object",
        "properties": {
          "home": {
            "type": ["number", "null"]
          },
          "away": {
            "type": ["number", "null"]
          }
        },
        "required": ["home", "away"]
      },
      "Score": {
        "type": "object",
        "properties": {
          "halftime": {
            "$ref": "#/components/schemas/Goals"
          },
          "fulltime": {
            "$ref": "#/components/schemas/Goals"
          },
          "extratime": {
            "$ref": "#/components/schemas/Goals"
          },
          "penalty": {
            "$ref": "#/components/schemas/Goals"
          }
        },
        "required": ["halftime", "fulltime", "extratime", "penalty"]
      },
      "FixtureFinal": {
        "type": "object",
        "properties": {
          "firstLegResult": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Goals"
              },
              {
                "type": "null"
              }
            ]
          },
          "winnerOfFinal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TeamId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["firstLegResult", "winnerOfFinal"]
      },
      "FixtureDTO": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "#/components/schemas/MongoDbId"
          },
          "fixture": {
            "$ref": "#/components/schemas/Fixture"
          },
          "league": {
            "$ref": "#/components/schemas/FixtureLeague"
          },
          "teams": {
            "$ref": "#/components/schemas/MatchTeams"
          },
          "goals": {
            "$ref": "#/components/schemas/Goals"
          },
          "score": {
            "$ref": "#/components/schemas/Score"
          }
        },
        "required": ["_id", "fixture", "league", "teams", "goals", "score"]
      },
      "ExtendedFixtureDTO": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FixtureDTO"
          },
          {
            "type": "object",
            "properties": {
              "final": {
                "$ref": "#/components/schemas/FixtureFinal"
              },
              "prediction": {
                "$ref": "#/components/schemas/FixturePrediction"
              },
              "evaluations": {
                "$ref": "#/components/schemas/FixtureEvaluations"
              }
            },
            "required": ["final"]
          }
        ]
      },
      "PredictionProbability": {
        "type": "number",
        "enum": [0.75, 0.8, 0.85, 0.9, 0.95],
        "x-typescript-constant": "PREDICTION_PROBABILITIES"
      },
      "PredictionCorrectValue": {
        "type": ["boolean", "null"],
        "enum": [null, false, true],
        "x-typescript-constant": "PREDICTION_CORRECT_VALUES"
      },
      "FixturePrediction": {
        "type": "object",
        "properties": {
          "bet": {
            "type": "string"
          },
          "qoute": {
            "type": "number",
            "description": "Existing wire field spelling. Renaming to quote would require a separate data migration."
          },
          "probability": {
            "$ref": "#/components/schemas/PredictionProbability"
          },
          "correct": {
            "$ref": "#/components/schemas/PredictionCorrectValue"
          }
        },
        "required": ["bet", "qoute", "probability", "correct"]
      },
      "AnalysisLevel": {
        "type": "string",
        "enum": ["LUCKY", "UNLUCKY"]
      },
      "AnalysisType": {
        "type": "string",
        "enum": [
          "GOAL",
          "NO_GOAL",
          "LAST_MINUTE_GOAL",
          "NO_FOUL",
          "PENALTY",
          "NO_PENALTY",
          "RED_CARD",
          "NO_RED_CARD",
          "KEY_PLAYER_INJURY",
          "KEY_PLAYER_YELLOW_CARD_SUSPENSION"
        ]
      },
      "EvaluationAnalyses": {
        "type": "object",
        "properties": {
          "level": {
            "$ref": "#/components/schemas/AnalysisLevel"
          },
          "type": {
            "$ref": "#/components/schemas/AnalysisType"
          },
          "minute": {
            "type": ["number", "null"]
          },
          "player": {
            "type": ["string", "null"]
          },
          "comments": {
            "type": ["string", "null"]
          }
        },
        "required": ["level", "type", "minute", "player", "comments"]
      },
      "EvaluationPerformance": {
        "type": "string",
        "enum": ["LOW", "MIDDLE", "HIGH"]
      },
      "FixtureEvaluation": {
        "type": "object",
        "properties": {
          "performance": {
            "$ref": "#/components/schemas/EvaluationPerformance"
          },
          "analyses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationAnalyses"
            }
          }
        },
        "required": ["performance", "analyses"]
      },
      "FixtureEvaluations": {
        "type": "object",
        "properties": {
          "home": {
            "$ref": "#/components/schemas/FixtureEvaluation"
          },
          "away": {
            "$ref": "#/components/schemas/FixtureEvaluation"
          }
        },
        "required": ["home", "away"]
      },
      "LatestFixturesDTO": {
        "type": "object",
        "properties": {
          "home": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtendedFixtureDTO"
            }
          },
          "away": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtendedFixtureDTO"
            }
          }
        },
        "required": ["home", "away"]
      },
      "FixtureHighlights": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/EventDTO"
        }
      },
      "GetFixtureDTO": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ExtendedFixtureDTO"
          },
          "highlights": {
            "$ref": "#/components/schemas/FixtureHighlights"
          }
        },
        "required": ["data", "highlights"]
      }
    }
  }
}
