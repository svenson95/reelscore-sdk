{
  "openapi": "3.1.0",
  "info": {
    "title": "reelscore fixtures contracts",
    "version": "0.2.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "FixtureLeague": {
        "allOf": [
          {
            "$ref": "./competitions.openapi.json#/components/schemas/LeagueBase"
          },
          {
            "type": "object",
            "properties": {
              "standings": {
                "type": "boolean"
              },
              "round": {
                "$ref": "./competitions.openapi.json#/components/schemas/CompetitionRound"
              }
            },
            "required": [
              "round"
            ]
          }
        ]
      },
      "FixtureDetail": {
        "type": "string",
        "enum": [
          "lineups",
          "fixture-statistics",
          "players-statistics",
          "events"
        ]
      },
      "FixtureId": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "string"
          }
        ]
      },
      "FixtureIdParameter": {
        "type": "string"
      },
      "FixtureDateString": {
        "type": "string",
        "description": "Existing fixture date string; no new format constraint is introduced by this migration."
      },
      "FixturePeriods": {
        "type": "object",
        "properties": {
          "first": {
            "type": "number"
          },
          "second": {
            "type": "number"
          }
        },
        "required": [
          "first",
          "second"
        ]
      },
      "FixtureVenue": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "$ref": "./teams.openapi.json#/components/schemas/VenueId"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "city"
        ]
      },
      "FixtureStatus": {
        "type": "object",
        "properties": {
          "long": {
            "$ref": "./fixture-status.openapi.json#/components/schemas/StatusLong"
          },
          "short": {
            "$ref": "./fixture-status.openapi.json#/components/schemas/StatusShort"
          },
          "elapsed": {
            "type": [
              "number",
              "null"
            ]
          },
          "extra": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "long",
          "short",
          "elapsed",
          "extra"
        ]
      },
      "FixtureResult": {
        "type": "string",
        "enum": [
          "NO_RESULT_AVAILABLE",
          "WIN",
          "DRAW",
          "LOSS"
        ]
      },
      "Fixture": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/FixtureId"
          },
          "referee": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "date": {
            "$ref": "#/components/schemas/FixtureDateString"
          },
          "timestamp": {
            "type": "number",
            "description": "Unix timestamp in seconds."
          },
          "periods": {
            "$ref": "#/components/schemas/FixturePeriods"
          },
          "venue": {
            "$ref": "#/components/schemas/FixtureVenue"
          },
          "status": {
            "$ref": "#/components/schemas/FixtureStatus"
          }
        },
        "required": [
          "id",
          "referee",
          "timezone",
          "date",
          "timestamp",
          "periods",
          "venue",
          "status"
        ]
      },
      "FixtureTeam": {
        "allOf": [
          {
            "$ref": "./teams.openapi.json#/components/schemas/Team"
          },
          {
            "type": "object",
            "properties": {
              "winner": {
                "type": "boolean"
              }
            },
            "required": [
              "winner"
            ]
          }
        ]
      },
      "MatchTeams": {
        "type": "object",
        "properties": {
          "home": {
            "$ref": "#/components/schemas/FixtureTeam"
          },
          "away": {
            "$ref": "#/components/schemas/FixtureTeam"
          }
        },
        "required": [
          "home",
          "away"
        ]
      },
      "Goals": {
        "type": "object",
        "properties": {
          "home": {
            "type": [
              "number",
              "null"
            ]
          },
          "away": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "home",
          "away"
        ]
      },
      "Score": {
        "type": "object",
        "properties": {
          "halftime": {
            "$ref": "#/components/schemas/Goals"
          },
          "fulltime": {
            "$ref": "#/components/schemas/Goals"
          },
          "extratime": {
            "$ref": "#/components/schemas/Goals"
          },
          "penalty": {
            "$ref": "#/components/schemas/Goals"
          }
        },
        "required": [
          "halftime",
          "fulltime",
          "extratime",
          "penalty"
        ]
      },
      "FixtureFinal": {
        "type": "object",
        "properties": {
          "firstLegResult": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Goals"
              },
              {
                "type": "null"
              }
            ]
          },
          "winnerOfFinal": {
            "anyOf": [
              {
                "$ref": "./teams.openapi.json#/components/schemas/TeamId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "firstLegResult",
          "winnerOfFinal"
        ]
      },
      "FixtureDTO": {
        "type": "object",
        "properties": {
          "_id": {
            "$ref": "./common.openapi.json#/components/schemas/MongoDbId"
          },
          "fixture": {
            "$ref": "#/components/schemas/Fixture"
          },
          "league": {
            "$ref": "#/components/schemas/FixtureLeague"
          },
          "teams": {
            "$ref": "#/components/schemas/MatchTeams"
          },
          "goals": {
            "$ref": "#/components/schemas/Goals"
          },
          "score": {
            "$ref": "#/components/schemas/Score"
          }
        },
        "required": [
          "_id",
          "fixture",
          "league",
          "teams",
          "goals",
          "score"
        ]
      },
      "ExtendedFixtureDTO": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FixtureDTO"
          },
          {
            "type": "object",
            "properties": {
              "final": {
                "$ref": "#/components/schemas/FixtureFinal"
              },
              "prediction": {
                "$ref": "#/components/schemas/FixturePrediction"
              },
              "evaluations": {
                "$ref": "./evaluations.openapi.json#/components/schemas/FixtureEvaluations"
              }
            },
            "required": [
              "final"
            ]
          }
        ]
      },
      "PredictionProbability": {
        "type": "number",
        "enum": [
          0.75,
          0.8,
          0.85,
          0.9,
          0.95
        ],
        "x-typescript-constant": "PREDICTION_PROBABILITIES"
      },
      "PredictionCorrectValue": {
        "type": [
          "boolean",
          "null"
        ],
        "enum": [
          null,
          false,
          true
        ],
        "x-typescript-constant": "PREDICTION_CORRECT_VALUES"
      },
      "FixturePrediction": {
        "type": "object",
        "properties": {
          "bet": {
            "type": "string"
          },
          "qoute": {
            "type": "number",
            "description": "Existing wire field spelling. Renaming to quote would require a separate data migration."
          },
          "probability": {
            "$ref": "#/components/schemas/PredictionProbability"
          },
          "correct": {
            "$ref": "#/components/schemas/PredictionCorrectValue"
          }
        },
        "required": [
          "bet",
          "qoute",
          "probability",
          "correct"
        ]
      },
      "LatestFixturesDTO": {
        "type": "object",
        "properties": {
          "home": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtendedFixtureDTO"
            }
          },
          "away": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExtendedFixtureDTO"
            }
          }
        },
        "required": [
          "home",
          "away"
        ]
      },
      "FixtureHighlights": {
        "type": "array",
        "items": {
          "$ref": "./events.openapi.json#/components/schemas/EventDTO"
        }
      },
      "GetFixtureDTO": {
        "type": "object",
        "properties": {
          "data": {
            "$ref": "#/components/schemas/ExtendedFixtureDTO"
          },
          "highlights": {
            "$ref": "#/components/schemas/FixtureHighlights"
          }
        },
        "required": [
          "data",
          "highlights"
        ]
      }
    }
  }
}
