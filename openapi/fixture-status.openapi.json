        "type": "string"
      },
      "StatusValueHalftime": {
        "type": "string",
        "enum": [
          "HT"
        ]
      },
      "StatusTypePlaying": {
        "type": "string"
      },
      "StatusTypeFinished": {
        "type": "string"
      },
      "StatusTypePostponed": {
        "type": "string",
        "enum": [
          "PST"
        ]
      },
      "StatusTypeCancelled": {
        "type": "string",
        "enum": [
          "CANC"
        ]
      },
      "StatusTypeAbandoned": {
        "type": "string",
        "enum": [
          "ABD"
        ]
      },
      "StatusTypeNotPlayed": {
        "type": "string"
      }
