{
  "openapi": "3.1.0",
  "info": {
    "title": "reelscore coaches contracts",
    "version": "0.2.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "TeamCoachDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "firstname": {
            "type": "string"
          },
          "lastname": {
            "type": "string"
          },
          "age": {
            "type": "number"
          },
          "birth": {
            "$ref": "#/components/schemas/CoachBirth"
          },
          "nationality": {
            "type": "string"
          },
          "height": {
            "type": "string"
          },
          "weight": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "team": {
            "$ref": "#/components/schemas/CoachTeam"
          },
          "career": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CareerItem"
            }
          }
        },
        "required": [
          "id",
          "name",
          "firstname",
          "lastname",
          "age",
          "birth",
          "nationality",
          "height",
          "weight",
          "photo",
          "team",
          "career"
        ]
      },
      "CoachBirth": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "place": {
            "type": "string"
          },
          "country": {
            "type": "string"
          }
        },
        "required": ["date", "place", "country"]
      },
      "CoachTeam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          }
        },
        "required": ["id", "name", "logo"]
      },
      "CareerItem": {
        "type": "object",
        "properties": {
          "team": {
            "$ref": "#/components/schemas/CareerTeam"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": ["string", "null"]
          }
        },
        "required": ["team", "start", "end"]
      },
      "CareerTeam": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "logo": {
            "type": "string"
          }
        },
        "required": ["id", "name", "logo"]
      },
      "GetAllTeamCoachesDTO": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamCoachesDocumentDTO"
            }
          },
          "length": {
            "type": "number"
          }
        },
        "required": ["data", "length"]
      },
      "TeamCoachesDocumentDTO": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "team": {
                "type": "string"
              }
            },
            "required": ["team"]
          },
          "response": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TeamCoachDTO"
            }
          },
          "lastFetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "__v": {
            "type": "integer"
          }
        },
        "required": [
          "_id",
          "parameters",
          "response",
          "createdAt",
          "updatedAt",
          "__v"
        ]
      }
    }
  }
}
