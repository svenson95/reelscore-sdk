{
  "openapi": "3.1.0",
  "info": {
    "title": "reelscore analyses contracts",
    "version": "0.2.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "FixturePlayersWithStreak": {
        "type": "object",
        "properties": {
          "home": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalScorerGoalsByMatch"
            }
          },
          "away": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoalScorerGoalsByMatch"
            }
          }
        },
        "required": [
          "home",
          "away"
        ]
      },
      "FixtureHomeOrAwayStrong": {
        "type": "object",
        "properties": {
          "home": {
            "type": "boolean"
          },
          "away": {
            "type": "boolean"
          }
        },
        "required": [
          "home",
          "away"
        ]
      },
      "GoalScorerGoalsByMatch": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "./players.openapi.json#/components/schemas/PlayerName"
          },
          "goalsByMatch": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "name",
          "goalsByMatch"
        ]
      },
      "AnalysesDTO": {
        "type": "object",
        "properties": {
          "playersWithStreak": {
            "$ref": "#/components/schemas/FixturePlayersWithStreak"
          },
          "homeOrAwayStrong": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/FixtureHomeOrAwayStrong"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "playersWithStreak",
          "homeOrAwayStrong"
        ]
      }
    }
  }
}
