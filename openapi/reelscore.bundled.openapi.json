          "Roughing",
          "Argument",
          "Holding",
          "Delay of game",
          "Elbowing",
          "Unsportsmanlike conduct",
          "Serious foul",
          "Goal cancelled",
          "Goal Disallowed - handball",
          "Goal Disallowed - offside",
          "Diving",
          "Penalty confirmed",
          "Substitution",
          "Substitution 1",
          "Substitution 2",
          "Substitution 3",
