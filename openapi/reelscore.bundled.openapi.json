          "First Half, Kick Off",
          "Halftime",
          "Second Half, 2nd Half Started",
          "Extra Time",
          "Break Time",
          "Penalty in Progress",
          "Match Suspended",
          "Match Interrupted",
          "Match Finished",
          "Match Postponed",
          "Match Cancelled",
          "Match Abandoned",
          "Technical Loss",
          "WalkOver",
          "In Progress"
